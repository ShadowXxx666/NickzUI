-- SELEÇÃO ANIMADA
local function SelectTab(name)
    if not Pages[name] then
        return
    end

    if SelectedTab == name then
        return
    end

    SelectedTab = name

    for tabName, page in pairs(Pages) do
        local active = tabName == name
        local data = TabButtons[tabName]

        page.Visible = active

        if active then
            data.Gradient.Enabled = true
            data.Gradient.Offset = Vector2.new(-1, 0)

            Animate(data.Gradient, {
                Offset = Vector2.new(0, 0)
            }, 0.38)

            Animate(data.Button, {
                BackgroundColor3 = Color3.new(1, 1, 1)
            }, 0.2)

            Animate(data.Stroke, {
                Transparency = 0.05,
                Thickness = 1.2
            }, 0.2)

            data.Indicator.Visible = true
            data.Indicator.Size = UDim2.new(0, 4, 0, 0)

            Animate(data.Indicator, {
                Size = UDim2.new(0, 4, 0, 27)
            }, 0.3)

            Animate(data.Label, {
                TextColor3 = Config.Text
            }, 0.2)

            Animate(data.Icon, {
                ImageColor3 = Color3.fromRGB(255, 255, 255)
            }, 0.2)

            Animate(data.Arrow, {
                TextTransparency = 0,
                Position = UDim2.new(1, -20, 0.5, -15)
            }, 0.2)

        else
            data.Gradient.Enabled = false

            Animate(data.Button, {
                BackgroundColor3 = Config.Card
            }, 0.2)

            Animate(data.Stroke, {
                Transparency = 1,
                Thickness = 1
            }, 0.2)

            data.Indicator.Visible = false

            Animate(data.Label, {
                TextColor3 = Config.Muted
            }, 0.2)

            Animate(data.Icon, {
                ImageColor3 = Config.Muted
            }, 0.2)

            Animate(data.Arrow, {
                TextTransparency = 0.2,
                Position = UDim2.new(1, -23, 0.5, -15)
            }, 0.2)
        end
    end
end

