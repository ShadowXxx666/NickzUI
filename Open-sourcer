    }, Frame)

    Corner(Switch, 20)

    local Circle = Create("Frame", {
        Size = UDim2.fromOffset(19, 19),
        Position = UDim2.fromOffset(3, 3),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0
    }, Switch)

    Corner(Circle, 20)

    local function Update()
        Animate(Switch, {
            BackgroundColor3 = State
                and Config.Accent
                or Color3.fromRGB(65, 55, 58)
        })

        Animate(Circle, {
            Position = State
                and UDim2.fromOffset(26, 3)
                or UDim2.fromOffset(3, 3)
        })

        if callback then
            callback(State)
        end
    end

    Switch.MouseButton1Click:Connect(function()
        State = not State
        Update()
    end)

    Update()

    return {
        Set = function(value)
            State = value
            Update()
        end,

        Get = function()
            return State
        end
    }
end

-- SLIDER
local function SliderElement(parent, text, min, max, default, callback)
    assert(max > min, "Slider: max precisa ser maior que min")

    local Value = math.clamp(default or min, min, max)

    local Frame = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 57),
        BackgroundColor3 = Config.Card,
        BorderSizePixel = 0,
        ClipsDescendants = true
    }, parent)

    Corner(Frame, 12)
    Stroke(Frame, Color3.fromRGB(75, 24, 32), 1)

    local AccentBar = Create("Frame", {
        Size = UDim2.new(0, 5, 0, 31),
        Position = UDim2.fromOffset(10, 13),
        BackgroundColor3 = Config.Accent,
        BorderSizePixel = 0
    }, Frame)

    Corner(AccentBar, 5)

    local Label = Create("TextLabel", {
        Size = UDim2.new(1, -160, 1, 0),
        Position = UDim2.fromOffset(25, 0),
        BackgroundTransparency = 1,
        Text = text,
        Font = Config.Font,
        TextSize = 14,
        TextColor3 = Config.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd
    }, Frame)

    local ValueLabel = Create("TextLabel", {
        Size = UDim2.fromOffset(115, 17),
        Position = UDim2.new(1, -130, 0, 8),
        BackgroundTransparency = 1,
        Text = tostring(Value),
        Font = Config.Font,
        TextSize = 12,
        TextColor3 = Config.Accent,
        TextXAlignment = Enum.TextXAlignment.Right
    }, Frame)

    local Bar = Create("TextButton", {
        Size = UDim2.fromOffset(115, 7),
        Position = UDim2.new(1, -130, 0, 34),
        BackgroundColor3 = Color3.fromRGB(65, 30, 37),
        Text = "",
        AutoButtonColor = false
    }, Frame)

    Corner(Bar, 10)

    local Fill = Create("Frame", {
        Size = UDim2.new((Value - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = Config.Accent,
        BorderSizePixel = 0
    }, Bar)

    Corner(Fill, 10)

    local Dragging = false

    local function SetValue(inputX, instant)
        local percent = math.clamp(
            (inputX - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X,
            0,
            1
        )

        Value = math.floor(min + (max - min) * percent + 0.5)
        percent = (Value - min) / (max - min)

        ValueLabel.Text = tostring(Value)

        if instant then
            Fill.Size = UDim2.new(percent, 0, 1, 0)
        else
            Animate(Fill, {
                Size = UDim2.new(percent, 0, 1, 0)
            }, 0.08)
        end

        if callback then
            callback(Value)
        end
    end

    Bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            Dragging = true
            SetValue(input.Position.X, true)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if Dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            SetValue(input.Position.X)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            Dragging = false
        end
    end)

    return {
        Set = function(value)
            Value = math.clamp(value, min, max)

            local percent = (Value - min) / (max - min)

            Fill.Size = UDim2.new(percent, 0, 1, 0)
            ValueLabel.Text = tostring(Value)

            if callback then
                callback(Value)
            end
        end,

        Get = function()
            return Value
        end
    }
end

