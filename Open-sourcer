        PaddingTop = UDim.new(0, 2),
        PaddingBottom = UDim.new(0, 2)
    }, OptionsList)

    local function BuildOptions()
        for _, child in ipairs(OptionsList:GetChildren()) do
            if child:IsA("TextButton") then
                child:Destroy()
            end
        end

        for _, option in ipairs(options) do
            local OptionButton = Create("TextButton", {
                Size = UDim2.new(1, 0, 0, 32),
                BackgroundColor3 = Config.Card,
                BackgroundTransparency = 1,
                Text = tostring(option),
                Font = Config.Font,
                TextSize = 12,
                TextColor3 = Config.Text,
                AutoButtonColor = false,
                ZIndex = 22
            }, OptionsList)

            Corner(OptionButton, 6)

            OptionButton.MouseEnter:Connect(function()
                Animate(OptionButton, {
                    BackgroundTransparency = 0,
                    BackgroundColor3 = Config.Accent
                }, 0.15)
            end)

            OptionButton.MouseLeave:Connect(function()
                Animate(OptionButton, {
                    BackgroundTransparency = 1
                }, 0.15)
            end)

            OptionButton.MouseButton1Click:Connect(function()
                Selected = option
                SelectedLabel.Text = tostring(option)

                Open = false

                Animate(Frame, {
                    Size = UDim2.new(1, 0, 0, 57)
                }, 0.18)

                Animate(OptionsFrame, {
                    Size = UDim2.new(0.53, -10, 0, 0)
                }, 0.15)

                task.delay(0.16, function()
                    if OptionsFrame.Parent and not Open then
                        OptionsFrame.Visible = false
                    end
                end)

                if callback then
                    callback(option)
                end
            end)
        end
    end

    BuildOptions()

    local function CloseDropdown()
        if not Open then
            return
        end

        Open = false

        Animate(Frame, {
            Size = UDim2.new(1, 0, 0, 57)
        }, 0.18)

        Animate(OptionsFrame, {
            Size = UDim2.new(0.53, -10, 0, 0)
        }, 0.15)

        task.delay(0.16, function()
            if OptionsFrame.Parent and not Open then
                OptionsFrame.Visible = false
            end
        end)
    end

    Selector.MouseButton1Click:Connect(function()
        if Open then
            CloseDropdown()
            return
        end

        Open = true
        OptionsFrame.Visible = true

        local Height = math.min(#options * 35 + 6, 175)

        Animate(Frame, {
            Size = UDim2.new(1, 0, 0, 57 + Height + 8)
        }, 0.2)

        OptionsFrame.Size = UDim2.new(0.53, -10, 0, 0)

        Animate(OptionsFrame, {
            Size = UDim2.new(0.53, -10, 0, Height)
        }, 0.2)
    end)

    return {
        Set = function(value)
            for _, option in ipairs(options) do
                if option == value then
                    Selected = value
                    SelectedLabel.Text = tostring(value)

                    if callback then
                        callback(value)
                    end

                    break
                end
            end
        end,

        Get = function()
            return Selected
        end,

        Refresh = function(newOptions)
            options = newOptions or {}
            Selected = options[1] or "Selecionar"
            SelectedLabel.Text = tostring(Selected)

            BuildOptions()

            if Open then
                CloseDropdown()
            end
        end
    }
end

